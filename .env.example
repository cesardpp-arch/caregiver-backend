ENV=local
TIMEZONE=America/New_York

# Strong secret required in production.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRE_MINUTES=720

# Comma-separated list of allowed front-end origins.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: in production, allow docs only from these IPs.
# Leave empty to disable IP allowlist check.
DOCS_ALLOWED_IPS=

# Login protection (window in seconds).
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# DB connection string.
SQLALCHEMY_DATABASE_URI=sqlite:///C:/Shana/caregiver-system/data/caregiver.db
