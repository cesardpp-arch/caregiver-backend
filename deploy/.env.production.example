ENV=production
TIMEZONE=America/New_York

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=720

# Your real domain(s) only — no localhost in production.
CORS_ALLOW_ORIGINS=https://yourdomain.com

# Restrict /docs to your office/home IP, or leave empty to disable entirely via ENABLE_DOCS=false
ENABLE_DOCS=false
ENABLE_REDOC=false
ENABLE_OPENAPI=false
DOCS_ALLOWED_IPS=

LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

SQLALCHEMY_DATABASE_URI=sqlite:////var/lib/caregiver/caregiver.db
