[Unit]
Description=Caregiver System API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=caregiver
Group=caregiver
WorkingDirectory=/srv/caregiver-system/backend
EnvironmentFile=/srv/caregiver-system/backend/.env
ExecStart=/srv/caregiver-system/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
